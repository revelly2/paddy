# ============================================================
# Paddy Rice Backend — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# --------------------------
# Supabase Project Credentials
# Find these in: Supabase Dashboard → Settings → API
# --------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --------------------------
# Roboflow API (Panicle Detection)
# Get your API key from: https://app.roboflow.com → Settings → API Key
# Model ID format: project-name/version (from the Deploy tab)
# --------------------------
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=panicle-seg/1

# --------------------------
# Storage
# Name of the Supabase Storage bucket for rice images
# --------------------------
STORAGE_BUCKET=rice-images

# --------------------------
# Server
# --------------------------
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# --------------------------
# CORS — Origins allowed to call this API
# In development: your Vite dev server URL
# In production: your deployed frontend URL
# --------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
